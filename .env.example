# ============================================================================
# RESPONDE — Variables de Entorno de Configuración
# ============================================================================

# 1. Supabase (Base de Datos & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Key (USO EXCLUSIVO SERVER-SIDE / EDGE FUNCTIONS)
# ADVERTENCIA: NUNCA expongas esta clave al frontend ni a variables NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-super-secret-service-role-key

# 2. Firebase Cloud Messaging (Push Notifications)
FCM_PROJECT_ID=responde-emergency
FCM_CLIENT_EMAIL=firebase-adminsdk@responde-emergency.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 3. Security & Anti-Replay Gateways
API_SECRET_SALT=your-random-cryptographic-salt-32-chars
DEFAULT_ACK_TIMEOUT_SECONDS=45
CORS_ALLOWED_ORIGINS=https://responde.app,https://cad.gob.cl

# 4. Deployment Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://responde.app
